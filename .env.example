# Copy to .env and fill in values — never commit .env

# Database (local dev uses postgres via docker-compose)
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/expense_splitter

# Cognito — create a User Pool and configure Google as a social IdP
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret
COGNITO_DOMAIN=your-domain-prefix   # prefix only, e.g. "expense-splitter-dev"

# Session (must match Cognito User Pool → App client → ID token expiry)
JWT_EXPIRY_SECONDS=86400

# CORS (comma-separated JSON array)
ALLOWED_ORIGINS='["http://localhost:5173"]'

# CSRF — generate with: openssl rand -hex 32
CSRF_SECRET_KEY=change-me-minimum-32-chars-random

# App
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DISABLE_DOCS=false
