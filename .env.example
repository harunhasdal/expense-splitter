# Copy to .env and fill in values — never commit .env

# Database (local dev uses postgres via docker-compose; backend/.env.example for SQLite)
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/expense_splitter

# JWT RS256 keys — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_EXPIRY_SECONDS=86400
JWT_ISSUER=http://localhost:8000

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# OAuth2 — Google (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 — GitHub (create at github.com/settings/applications)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CSRF
CSRF_SECRET_KEY=change-me-minimum-32-chars-random

# App
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DISABLE_DOCS=false
