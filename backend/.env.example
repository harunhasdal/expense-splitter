# Database
DATABASE_URL=sqlite+aiosqlite:///./expense_splitter.db

# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRY_SECONDS=86400
JWT_ISSUER=http://localhost:8000

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# OAuth2 — Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 — GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CSRF
CSRF_SECRET_KEY=change-me-to-a-random-secret

# App
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DISABLE_DOCS=false
